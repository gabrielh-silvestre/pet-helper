{
  "schema": 1,
  "project": "pet-helper",
  "unit": {
    "kind": "execution (one objective, one branch, one PR)",
    "location": "docs/specs/<slug>",
    "examples": [
      {
        "path": "docs/specs/feat-order-lookup",
        "process": "docs-specs-feat-order-lookup"
      },
      {
        "path": "docs/specs/feat-policy-rag",
        "process": "docs-specs-feat-policy-rag"
      }
    ]
  },
  "phases": [
    {
      "name": "interview",
      "command": "M1 /pre-code step 2",
      "type": "interview",
      "target": "interview",
      "artifact": "docs/specs/<slug>/spec.md",
      "links": []
    },
    {
      "name": "plan",
      "command": "M1 /pre-code step 3",
      "type": "plan",
      "target": "plan",
      "artifact": "docs/specs/<slug>/plan.md",
      "links": [
        {
          "relation": "plan-derives-from-interview",
          "to": "interview"
        }
      ]
    },
    {
      "name": "architecture",
      "command": "M1 /pre-code step 4",
      "type": "architecture",
      "target": "architecture",
      "artifact": "docs/specs/<slug>/architecture.md",
      "links": [
        {
          "relation": "architecture-derives-from-plan",
          "to": "plan"
        }
      ]
    },
    {
      "name": "approval",
      "command": "M1 /pre-code step 5",
      "type": "approval",
      "target": "approval",
      "artifact": "docs/specs/<slug>/architecture.md",
      "links": [
        {
          "relation": "approval-derives-from-architecture",
          "to": "architecture"
        }
      ]
    },
    {
      "name": "delivery",
      "command": "M2 /deliver step 4",
      "type": "delivery",
      "target": "delivery",
      "artifact": ".omc/prd.json",
      "links": [
        {
          "relation": "delivery-derives-from-approval",
          "to": "approval"
        }
      ]
    },
    {
      "name": "local-review",
      "command": "M2 /deliver step 5",
      "type": "local-review",
      "target": "local-review",
      "artifact": ".ignore/reviews/",
      "links": [
        {
          "relation": "local-review-derives-from-delivery",
          "to": "delivery"
        }
      ]
    },
    {
      "name": "panel-review",
      "command": "M3 /pr-panel step 6",
      "type": "panel-review",
      "target": "panel-review",
      "artifact": ".ignore/reviews/prs/PR<N>/review.md",
      "links": [
        {
          "relation": "panel-review-derives-from-local-review",
          "to": "local-review"
        }
      ]
    }
  ],
