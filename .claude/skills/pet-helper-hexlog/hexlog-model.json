            "minLength": 1,
            "maxLength": 600
          },
          "document": {
            "type": "string",
            "format": "attachment"
          }
        },
        "required": [
          "unit",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delivery",
      "schema": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "document": {
            "type": "string",
