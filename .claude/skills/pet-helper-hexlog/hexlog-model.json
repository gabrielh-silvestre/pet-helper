{
  "schema": 1,
  "project": "pet-helper",
  "unit": {
    "kind": "execution (one objective, one branch, one PR)",
    "location": "docs/specs/<slug>",
    "examples": [
      {
        "path": "docs/specs/feat-order-lookup",
        "process": "docs-specs-feat-order-lookup"
      },
      {
        "path": "docs/specs/feat-policy-rag",
        "process": "docs-specs-feat-policy-rag"
      }
    ]
  },
  "phases": [
    {
      "name": "interview",
      "command": "/oh-my-claudecode:deep-interview --frontier",
      "type": "interview",
      "target": "interview",
      "artifact": "docs/specs/<slug>/spec.md",
      "links": []
    },
    {
      "name": "plan",
      "command": "/oh-my-claudecode:ralplan",
      "type": "plan",
      "target": "plan",
      "artifact": "docs/specs/<slug>/plan.md",
      "links": [
        {
          "relation": "plan-derives-from-interview",
          "to": "interview"
        }
      ]
    },
    {
      "name": "architecture",
      "command": "/owner-seat",
      "type": "architecture",
      "target": "architecture",
      "artifact": "docs/specs/<slug>/architecture.md",
      "links": [
        {
          "relation": "architecture-derives-from-plan",
          "to": "plan"
        }
      ]
    },
    {
      "name": "delivery",
      "command": "/oh-my-claudecode:ralph",
      "type": "delivery",
      "target": "delivery",
      "artifact": ".omc/prd.json",
      "links": [
        {
          "relation": "delivery-derives-from-architecture",
          "to": "architecture"
        }
      ]
    },
    {
      "name": "local-review",
      "command": "/review-pr --normal",
      "type": "local-review",
      "target": "local-review",
      "artifact": ".ignore/reviews/",
      "links": [
        {
          "relation": "local-review-derives-from-delivery",
          "to": "delivery"
        }
      ]
    },
    {
      "name": "panel-review",
      "command": "/review-pr --panel",
      "type": "panel-review",
      "target": "panel-review",
      "artifact": ".ignore/reviews/prs/PR<N>/review.md",
      "links": [
        {
          "relation": "panel-review-derives-from-local-review",
          "to": "local-review"
        }
      ]
    }
  ],
  "types": [
    {
      "name": "interview",
      "schema": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "document": {
            "type": "string",
            "format": "attachment"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "unit",
          "summary",
          "objective"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "plan",
      "schema": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
